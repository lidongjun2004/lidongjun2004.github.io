---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About" description="About L.D.J">
  <Header slot="header" />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <img
        src="/images/about/portrait.jpg"
        alt="李东骏的个人照"
        width="1080"
        height="1619"
        class="w-28 h-28 mx-auto mb-6 rounded-full object-cover object-[center_36%] shadow-sm"
      />
      <h1 class="text-3xl font-bold text-[var(--color-heading)] mb-2">李东骏</h1>
      <p class="text-lg text-[var(--color-text-light)]">L.D.J</p>
    </div>

    <div class="prose mx-auto">
      <h2>Goal</h2>
      <p>
        希望通过力所能及、各种意义上的“开源”工作——知识、工具、经验、思想，
        创造社会意义上和经济意义上的价值，并构建个人影响力。
      </p>

      <h2>Journey</h2>
      <p>
        <strong>2026.02 — Present</strong><br />
        MiniMax · ML Systems Engineer Intern
      </p>
      <p>
        <strong>2025.12 — Present</strong><br />
        Hetao Coding · Competitive Programming Teacher
      </p>
      <p>
        <strong>2023 — 2027</strong><br />
        Beihang University · Undergraduate
      </p>
      <p>
        <strong>2017.09 — 2023.06</strong><br />
        RDFZ · Student
      </p>

      <h2>Contact</h2>
      <p>Open to contact.</p>
      <ul>
        <li>
          <strong>GitHub</strong> ·
          <a href="https://github.com/lidongjun2004">@lidongjun2004</a>
        </li>
        <li>
          <strong>Email</strong> ·
          <a
            class="break-words"
            href="mailto:lidongjun20040927@gmail.com"
          >lidongjun20040927@gmail.com</a>
        </li>
        <li><strong>WeChat</strong> · lidongjun2004</li>
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
